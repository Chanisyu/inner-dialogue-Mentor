{
  "name": "inner-dialogue",
  "version": "2.10.0",
  "description": "保存在本地、能够持续记录的 AI 心理支持工具包（简体中文）",
  "type": "module",
  "bin": {
    "inner-dialogue": "bin/inner-dialogue.js"
  },
  "engines": {
    "node": ">=18.3"
  },
  "files": [
    "bin/",
    "cli/",
    "hooks/",
    "personas/",
    "modalities/",
    "structures/",
    "context/",
    "safety-protocol.md",
    "commands.md",
    "profile-protocol.md",
    "usage-reflection.md",
    "CLAUDE.template.md",
    "profile.template.md",
    "claude-settings.template.json",
    "manifest.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/",
    "CLAUDE.md",
    "MIGRATING.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "interaction/",
    "transcript-protocol.md"
  ],
  "scripts": {
    "test": "node --test cli/__tests__/*.test.js",
    "test:evals": "node --test evals/__tests__/*.test.js",
    "test:zh-safety": "node hooks/zh-safety-check.mjs"
  },
  "keywords": [
    "therapy",
    "ai",
    "claude",
    "mental-health",
    "self-reflection",
    "journaling"
  ],
  "homepage": "https://github.com/ataglianetti/inner-dialogue",
  "repository": {
    "type": "git",
    "url": "https://github.com/ataglianetti/inner-dialogue.git"
  },
  "bugs": {
    "url": "https://github.com/ataglianetti/inner-dialogue/issues"
  },
  "license": "MIT",

{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var d=new Date();var p=function(n){return(n<10?'0':'')+n};var tz=d.toLocaleTimeString('en-US',{timeZoneName:'short'}).split(' ').pop();var day=d.toLocaleDateString('zh-CN',{weekday:'long'});console.log(JSON.stringify({hookSpecificOutput:{hookEventName:'UserPromptSubmit',additionalContext:'当前本地时间：'+p(d.getHours())+':'+p(d.getMinutes())+' '+tz+', '+day+' '+d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())}}))\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.therapy/hooks/safety-net.js"
            ]
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.therapy/hooks/runtime-log.cjs"
            ]
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.therapy/hooks/transcript-archive.cjs"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.therapy/hooks/usage-stats.js"
            ]
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",

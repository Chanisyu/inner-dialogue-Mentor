{
  "version": "1.8.0",
  "description": "Inner Dialogue 可更新组件（简体中文）",
  "base_url": "https://raw.githubusercontent.com/ataglianetti/inner-dialogue/main/",
  "components": {
    "usage-stats-context": {
      "file": "hooks/usage-stats-context.cjs",
      "target": ".therapy/hooks/usage-stats-context.cjs",
      "required": true,
      "description": "使用统计输出适配；保留原统计记录，助手和未选择模式不接收使用节奏建议。"
    },
    "codex-runtime": {
      "file": "hooks/codex-runtime.cjs",
      "target": ".therapy/hooks/codex-runtime.cjs",
      "required": true,
      "description": "Codex 主对话生命周期适配；由 archive-version.json 管理，不修改全局配置。"
    },
    "codex-transcript": {
      "file": "hooks/codex-transcript.cjs",
      "target": ".therapy/hooks/codex-transcript.cjs",
      "required": true,
      "description": "Codex 真实可见原文解析与稳定会话身份映射。"
    },
    "local-storage": {
      "file": "hooks/local-storage.cjs",
      "target": ".therapy/hooks/local-storage.cjs",
      "required": true,
      "description": "跨客户端本地路径、原子发布和私有状态存储工具。"
    },
    "shared-memory": {
      "file": "hooks/shared-memory.cjs",
      "target": ".therapy/hooks/shared-memory.cjs",
      "required": true,
      "description": "共享资料版本、候选稿提交、并发冲突校验与事务恢复。"
    },
    "client-entry": {
      "file": "client-entry.md",
      "target": ".therapy/client-entry.md",
      "required": true,
      "description": "两个客户端共用业务入口的启动规则。"
    },
    "shared-memory-protocol": {
      "file": "shared-memory-protocol.md",
      "target": ".therapy/shared-memory-protocol.md",
      "required": true,
      "description": "模型按需重读、按统一入口提交共享资料的协议。"
    },
    "transcript-archive": {
      "file": "hooks/transcript-archive.cjs",
      "target": ".therapy/hooks/transcript-archive.cjs",
      "required": true,
      "description": "独立归档组件：模型确认主动收尾后请求，Stop 补齐最终回应并保存精简 JSONL 与 Markdown；由 archive-version.json 管理。"
    },
    "transcript-protocol": {
      "file": "transcript-protocol.md",
      "target": ".therapy/transcript-protocol.md",
      "required": true,
      "description": "主动收尾与按需读取原文的规则，通过独立钩子加载，保留已冻结咨询正文。"
    },
    "safety-protocol": {
      "file": "safety-protocol.md",
      "target": ".therapy/safety-protocol.md",
      "required": true,
      "description": "危机应对流程与安全边界"
    },
    "commands": {
      "file": "commands.md",
      "target": ".therapy/commands.md",
      "required": true,
      "description": "导入、更新、更换人格等自定义命令"
    },
    "profile-protocol": {
      "file": "profile-protocol.md",
      "target": ".therapy/profile-protocol.md",
      "required": true,
      "description": "档案来源规则：记录确认日期，并在内容过期时征求复核。通过 CLAUDE.md 或 commands.md 在会谈开始时读取。"
    },
    "safety-net": {
      "file": "hooks/safety-net.js",
      "target": ".therapy/hooks/safety-net.js",
      "required": true,
      "description": "中英文危机措辞的机械匹配钩子。匹配时注入安全提醒；安全流程正文仍是主要依据。它不是临床风险评估。"
    },
    "usage-stats": {
      "file": "hooks/usage-stats.js",
      "target": ".therapy/hooks/usage-stats.js",
      "required": true,
      "description": "会谈开始时提供使用节奏的机械统计，仅提供事实供咨询师判断；出错时静默放行。"
    },
    "runtime-log": {
      "file": "hooks/runtime-log.cjs",
      "target": ".therapy/hooks/runtime-log.cjs",
      "required": true,
      "description": "统一本地运行日志：观察会话与工具事件，记录模式及 CLI 错误；白名单元数据、不记录正文，文件自动轮转。"
    },
    "usage-reflection": {
      "file": "usage-reflection.md",
      "target": ".therapy/usage-reflection.md",
      "required": true,
      "description": "如何温和地使用统计信息：适当时机最多提一次，不作为危机筛查。"
    },
    "claude-settings": {
      "file": "claude-settings.template.json",
      "target": ".claude/settings.json",
      "required": false,
      "scaffold_only": true,
      "description": "Claude Code 钩子配置：提交消息时提供本地时间和安全提醒，会谈开始时提供使用统计。仅创建缺失配置，既有配置不整体覆盖。"
    },
    "context-index": {
      "file": "context/index.template.md",
      "target": "context/index.md",
      "required": false,
      "scaffold_only": true,
      "description": "人物、地点、概念、事件背景库的读取索引。安装或更新时仅在缺失时创建。"
    }
  },
  "library": {
    "personas": {
      "target": ".therapy/library/personas/",
      "description": "交流风格选项",
      "files": [
        "personas/warm-4o.md",
        "personas/direct-challenging.md",
        "personas/warm-supportive.md",
        "personas/coach.md",
        "personas/grounded-real.md",
        "personas/contemplative.md",
        "personas/philosophical.md",
        "personas/creative.md"
      ]
    },
    "modalities": {
      "target": ".therapy/library/modalities/",
      "description": "心理咨询方法选项",
      "files": [
        "modalities/cbt.md",
        "modalities/act.md",
        "modalities/cft.md",
        "modalities/dbt-skills.md",
        "modalities/ifs.md",
        "modalities/lifespan-integration.md",
        "modalities/motivational-interviewing.md",
        "modalities/narrative.md",
        "modalities/polyvagal.md",
        "modalities/psychodynamic.md",
        "modalities/sfbt.md",
        "modalities/somatic-experiencing.md",
        "modalities/ideal-parent-figure.md"
      ]
    },
    "structures": {
      "target": ".therapy/library/structures/",
      "description": "会谈结构选项",
      "files": [
        "structures/structured.md",
        "structures/moderate.md",
        "structures/freeform.md"
      ]
    }
  },
  "extensions": {
    "dual-mode": {
      "version": "1.1.0",
      "optional": true,
      "description": "咨询、朋友与助手模式；助手仅加载资料导航及存储协议，朋友独立人格和篇幅，按对话锁定；原咨询正文及依赖冻结。",
      "source": "interaction/",
      "enable_command": "inner-dialogue dual-mode --path <目录>",
      "runtime": "hooks/session-mode.cjs"
    }
  }
}
